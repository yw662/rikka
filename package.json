{
  "name": "project-rikka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Web Components toolkit for developers and LLMs",
  "scripts": {
    "build": "pnpm -r build",
    "test": "node scripts/test.mjs",
    "test:watch": "pnpm -r --parallel run test:watch",
    "test:all": "node scripts/ci.mjs",
    "homepage": "pnpm --filter rikka-homepage dev",
    "typecheck": "node scripts/typecheck.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm changeset publish"
  },
  "packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d",
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

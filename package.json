{
  "name": "project-rikka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Web Components toolkit for developers and LLMs",
  "scripts": {
    "build": "pnpm -r build",
    "test": "node scripts/test.mjs",
    "test:watch": "pnpm -r --parallel run test:watch",
    "test:all": "node scripts/ci.mjs",
    "homepage": "pnpm --filter rikka-homepage dev",
    "typecheck": "node scripts/typecheck.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm changeset publish"
  },
  "packageManager": "pnpm@10.34.1+sha512.b58fbde6dca66a929538021581f648b4570b6ca19b18e7cbd7f2c07a7b24454155388dacdf08f2af3678e88a6d1fe04f9d609df24bf51735a060ea041b374ab7",
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

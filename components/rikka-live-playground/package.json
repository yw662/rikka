{
  "name": "@rikka/live-playground",
  "version": "0.1.0",
  "description": "Live code editor component powered by esbuild-wasm",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yw662/rikka.git",
    "directory": "components/rikka-live-playground"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rstest",
    "test:watch": "rstest -w"
  },
  "dependencies": {
    "esbuild-wasm": "catalog:",
    "@rikka/dom": "workspace:*",
    "@rikka/elements": "workspace:*",
    "@rikka/signal": "workspace:*"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@rstest/core": "catalog:",
    "@rstest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:"
  }
}
